{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "scripts/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "tests/**/*.mjs",
      "*.ts",
      "*.json",
      "*.jsonc",
      "src/**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "**",
      "!src/components/admin/DuplicateReviewDecisionForm.tsx",
      "!tests/candidate-duplicate-review-api.test.ts",
      "!tests/candidate-duplicate-review-component.test.tsx"
    ],
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "suspicious": {
        "noDuplicateProperties": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/run-ops-p6-002a-configured-staging-p6-07-isolated-restore.mjs"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnsafeFinally": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  }
}
